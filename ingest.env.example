# Скопируй в ingest.env. Значения ниже совпадают с docker-compose.dev.yml.

# --- сеть сервиса ---
# Платформенный порт: /health и /v1/platform/*. Сюда ходит master_node.
INGEST_HOST=127.0.0.1
INGEST_PORT=8011

# Внутренний порт: /embed, /v1/internal/*, /admin/*. Наружу не публикуется.
# 0 — не разводить, всё на платформенном порту (см. docs/ports.md).
INGEST_INTERNAL_HOST=127.0.0.1
INGEST_INTERNAL_PORT=8012
INGEST_RELOAD=false
INGEST_LOG_LEVEL=info

# Адрес, по которому ВОРКЕР зовёт /embed основного процесса.
# В docker-compose это имя сервиса, а не localhost: воркер живёт
# в отдельном контейнере и до localhost родителя не достучится.
INGEST_SELF_URL=http://localhost:8012

# --- docling ---
INGEST_DOCLING_URL=http://localhost:5001
# INGEST_DOCLING_API_KEY=

# --- OpenSearch ---
INGEST_OPENSEARCH_URL=http://localhost:9200
INGEST_INDEX_NAME=kb-v2
# Дефолт opensearch-py — 10 секунд; на bulk из сотен чанков с векторами
# по 1024 измерения этого не хватает, и падает не индексация, а транспорт.
INGEST_OPENSEARCH_TIMEOUT=60
# Принудительный refresh после каждого документа: чанки видны сразу, ценой
# отдельного сегмента. На массовом импорте выключай — тогда видимость
# отстаёт на refresh_interval (30 с).
INGEST_REFRESH_AFTER_LOAD=true

# --- эмбеддинги ---
INGEST_EMBED_MODEL=BAAI/bge-m3
INGEST_EMBED_BATCH_SIZE=16
INGEST_EMBED_CONCURRENCY=1
# Второй экземпляр модели под запросы: чат не должен стоять в очереди
# за батчами индексации. Стоит ~1.5 ГБ VRAM.
INGEST_SEPARATE_QUERY_EMBEDDER=true
INGEST_EMBED_QUERY_CONCURRENCY=2
INGEST_EMBED_QUERY_BATCH_SIZE=8

# --- OCR ---
INGEST_OCR_ENGINE=easyocr
INGEST_OCR_LANG=ru,en
INGEST_FORCE_OCR=true

# --- control plane ---
INGEST_DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5437/rag_ingest
# База 1: на нулевой сидит очередь docling.
INGEST_REDIS_URL=redis://localhost:6379/1
INGEST_RQ_QUEUE_INGEST=ingest
INGEST_RQ_QUEUE_MAINTENANCE=maintenance

# --- SeaweedFS ---
INGEST_S3_ENDPOINT_URL=http://localhost:8333
# Адрес, попадающий в presigned-ссылку. По ней приходит docling, а он
# в контейнере: localhost для него — он сам, а не SeaweedFS. Оба сервиса
# в одной сети compose, поэтому имя сервиса резолвится.
# Если сам сервис тоже запущен в контейнере, значения совпадают.
INGEST_S3_PRESIGN_ENDPOINT_URL=http://seaweedfs:8333

# Как файл попадает в docling: url (presigned-ссылка, качает docling) или
# upload (качает воркер и шлёт multipart). url экономит один хоп, но
# требует, чтобы docling видел хранилище и пропускал его адрес через свой
# allowlist для http_sources — приватные адреса он режет как SSRF.
INGEST_DOCLING_TRANSFER=upload
INGEST_S3_ACCESS_KEY=rag
INGEST_S3_SECRET_KEY=rag
INGEST_S3_BUCKET_DOCS=rag-docs
INGEST_S3_BUCKET_ICONS=rag-icons
INGEST_S3_BUCKET_STAGING=rag-staging

# --- лимиты архива: серверные, пользователь их не задаёт ---
INGEST_ARCHIVE_MAX_ENTRIES=2000
INGEST_ARCHIVE_MAX_UNCOMPRESSED=5368709120
INGEST_ARCHIVE_MAX_RATIO=120
INGEST_ARCHIVE_MAX_FILE_SIZE=209715200

# --- импорт из чужого бакета ---
# Содержимое при приёме не читается: размер берётся из листинга S3.
INGEST_BUCKET_IMPORT_MAX_FILE_SIZE=52428800
INGEST_BUCKET_IMPORT_MAX_FILES=500

# --- квоты набора ---
INGEST_RAG_MAX_SETS_PER_OWNER=50
INGEST_RAG_MAX_BYTES_PER_SET=21474836480
